<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);
include __DIR__ . "/../config/config.php";

// ============================================================
// CARREGAR PROJETO E AMBIENTE
// ============================================================
$projeto_id = (int)($_GET['projeto_id'] ?? 0);
$ambiente_id = (int)($_GET['ambiente_id'] ?? 0);
if (!$projeto_id || !$ambiente_id) { header("Location: residencial_ambiente.php"); exit; }

$proj = $conn->query("SELECT * FROM projetos WHERE id = $projeto_id")->fetch_assoc();
$amb = $conn->query("SELECT * FROM ambientes WHERE id = $ambiente_id AND projeto_id = $projeto_id")->fetch_assoc();
if (!$proj || !$amb) { header("Location: residencial_ambiente.php?projeto_id=$projeto_id"); exit; }

function val($arr, $chave, $padrao = '') {
    return isset($arr[$chave]) ? $arr[$chave] : $padrao;
}

$mensagem_sucesso = '';

// ============================================================
// CONSTANTES TÉCNICAS
// ============================================================
$IRRADIACAO_SOLAR = [
    'Norte'    => 550, 'Nordeste' => 520, 'Leste' => 600, 'Sudeste' => 400,
    'Sul'      => 200, 'Sudoeste' => 500, 'Oeste' => 700, 'Noroeste' => 620,
];

$TIPO_VIDRO = [
    'comum'     => ['U' => 5.8, 'tau' => 0.85],
    'duplo'     => ['U' => 2.8, 'tau' => 0.70],
    'low_e'     => ['U' => 1.5, 'tau' => 0.40],
    'temperado' => ['U' => 5.5, 'tau' => 0.78],
    'laminado'  => ['U' => 5.5, 'tau' => 0.75],
    'refletivo' => ['U' => 5.5, 'tau' => 0.35],
];

$COEF_U_MATERIAIS = [
    'Tijolo cerâmico 1/2 vez' => 2.40, 'Tijolo cerâmico 1 vez' => 1.70,
    'Bloco de concreto' => 2.80, 'Concreto maciço' => 3.50,
    'Madeira' => 0.60, 'Drywall' => 1.80, 'Vidro' => 5.80, 'Outro' => 2.00,
];

$EQUIPAMENTOS_COMERCIAIS = [
    7000, 9000, 10000, 12000, 15000, 18000, 22000, 24000, 30000, 36000, 48000
];

$delta_T = (float)val($proj, 'temp_externa_verao', 32.0) - (float)val($proj, 'temp_interna_verao', 24.0);
$delta_T_ar = 10.0; // °C — temperatura de insuflamento
$margem_seguranca = 0.10; // 10%

// ============================================================
// DADOS DO AMBIENTE (Etapa 1)
// ============================================================
$comp_amb = (float)val($amb, 'comprimento_m', 0);
$larg_amb = (float)val($amb, 'largura_m', 0);
$pe_direito = (float)val($amb, 'peDireita_m', 2.8);
$area_ambiente = $comp_amb * $larg_amb;
$volume_ambiente = $area_ambiente * $pe_direito;

// ============================================================
// 1. CONDUÇÃO + RADIAÇÃO — PAREDES (Etapa 2 + 3)
// ============================================================
$Q_paredes_cond = 0;
$Q_paredes_rad = 0;
$paredes = [];

$res_p = $conn->query("SELECT * FROM paredes_ambiente WHERE ambiente_id = $ambiente_id");
while ($p = $res_p->fetch_assoc()) {
    $comp = (float)($p['comprimento_m'] ?? 0);
    $alt = (float)($p['altura_m'] ?? 0);
    if ($comp <= 0 || $alt <= 0) continue;
    
    $area = $comp * $alt;
    $U = $COEF_U_MATERIAIS[$p['material']] ?? 2.0;
    $alpha = (float)($p['coef_absorcao_solar'] ?? 0.30);
    $I = $IRRADIACAO_SOLAR[$p['nome']] ?? 400;
    
    $q_cond = $U * $area * $delta_T;
    $q_rad = $alpha * $I * $area * 0.85;
    
    $Q_paredes_cond += $q_cond;
    $Q_paredes_rad += $q_rad;
    
    $paredes[] = [
        'nome' => $p['nome'], 'area' => $area, 'material' => $p['material'],
        'U' => $U, 'alpha' => $alpha, 'I' => $I,
        'q_cond' => $q_cond, 'q_rad' => $q_rad, 'q_total' => $q_cond + $q_rad,
    ];
}

// ============================================================
// 2. CONDUÇÃO + RADIAÇÃO — JANELAS (Etapa 2 + 3)
// ============================================================
$Q_janelas_cond = 0;
$Q_janelas_rad = 0;
$Q_infiltracao_total = 0;
$janelas = [];

// Carrega configurações de ganho_solar
$config_solar = [];
$res_gs = $conn->query("SELECT * FROM ganho_solar WHERE ambiente_id = $ambiente_id");
while ($gs = $res_gs->fetch_assoc()) {
    $config_solar[(int)$gs['item_id']] = $gs;
}

$res_i = $conn->query("
    SELECT ip.*, pa.nome AS orientacao_parede
    FROM itens_parede ip
    JOIN paredes_ambiente pa ON pa.id = ip.parede_id
    WHERE pa.ambiente_id = $ambiente_id
");
while ($it = $res_i->fetch_assoc()) {
    $larg = (float)($it['largura_m'] ?? 0);
    $alt = (float)($it['altura_m'] ?? 0);
    $area = $larg * $alt;
    if ($area <= 0) continue;
    
    $orientacao = $it['orientacao_parede'] ?? 'Norte';
    $I = $IRRADIACAO_SOLAR[$orientacao] ?? 400;
    
    $cfg = $config_solar[(int)$it['id']] ?? null;
    $tipo_vidro = $cfg['tipo_vidro'] ?? 'comum';
    $fator_sombra = (float)($cfg['fator_sombra'] ?? 1.0);
    
    if (!isset($TIPO_VIDRO[$tipo_vidro])) $tipo_vidro = 'comum';
    $U_vidro = $TIPO_VIDRO[$tipo_vidro]['U'];
    $tau = $TIPO_VIDRO[$tipo_vidro]['tau'];
    
    $q_cond = $U_vidro * $area * $delta_T;
    $q_rad = $tau * $I * $area * $fator_sombra;
    $q_inf = (float)($it['carga_infiltracao_w'] ?? 0);
    
    $Q_janelas_cond += $q_cond;
    $Q_janelas_rad += $q_rad;
    $Q_infiltracao_total += $q_inf;
    
    $janelas[] = [
        'nome' => $it['nome_item'], 'tipo' => $it['tipo_item'],
        'orientacao' => $orientacao, 'area' => $area,
        'tipo_vidro' => $tipo_vidro, 'fator_sombra' => $fator_sombra,
        'q_cond' => $q_cond, 'q_rad' => $q_rad, 'q_inf' => $q_inf,
        'q_total' => $q_cond + $q_rad + $q_inf,
    ];
}

// ============================================================
// 3. INFILTRAÇÃO — Separação sensível/latente
// ============================================================
// 75% sensível / 25% latente (aproximação)
$Q_inf_sens = $Q_infiltracao_total * 0.75;
$Q_inf_lat = $Q_infiltracao_total * 0.25;

// ============================================================
// 4. CARGAS INTERNAS (Etapa 4)
// ============================================================
$ci = $conn->query("SELECT * FROM cargas_internas WHERE ambiente_id = $ambiente_id LIMIT 1")->fetch_assoc();

$Q_int_sens = 0;
$Q_int_lat = 0;
$cargas_detalhe = [];

if ($ci) {
    // Pessoas
    $q_pessoas = (int)($ci['pessoas'] ?? 0) * (float)($ci['calor_por_pessoa_w'] ?? 115) * (float)($ci['fator_simultaneidade_pessoas'] ?? 0.90);
    $q_pessoas_sens = $q_pessoas * 0.58;
    $q_pessoas_lat = $q_pessoas * 0.42;
    
    // Iluminação
    $q_ilum = (float)($ci['potencia_iluminacao_w'] ?? 0) * (float)($ci['fator_simultaneidade_iluminacao'] ?? 1.0);
    $q_ilum_sens = $q_ilum;
    $q_ilum_lat = 0;
    
    // Equipamentos
    $q_equip = (float)($ci['potencia_equipamentos_w'] ?? 0) * (float)($ci['fator_simultaneidade_equipamentos'] ?? 0.70);
    $q_equip_sens = $q_equip * 0.70;
    $q_equip_lat = $q_equip * 0.30;
    
    $Q_int_sens = $q_pessoas_sens + $q_ilum_sens + $q_equip_sens;
    $Q_int_lat = $q_pessoas_lat + $q_ilum_lat + $q_equip_lat;
    
    $cargas_detalhe = [
        'pessoas' => ['sens' => $q_pessoas_sens, 'lat' => $q_pessoas_lat, 'total' => $q_pessoas],
        'iluminacao' => ['sens' => $q_ilum_sens, 'lat' => $q_ilum_lat, 'total' => $q_ilum],
        'equipamentos' => ['sens' => $q_equip_sens, 'lat' => $q_equip_lat, 'total' => $q_equip],
    ];
}

// ============================================================
// 5. BALANÇO TÉRMICO TOTAL
// ============================================================
$Q_sensivel_total = $Q_paredes_cond + $Q_paredes_rad + $Q_janelas_cond + $Q_janelas_rad + $Q_inf_sens + $Q_int_sens;
$Q_latente_total = $Q_inf_lat + $Q_int_lat;
$Q_total = $Q_sensivel_total + $Q_latente_total;

// SHR
$SHR = $Q_total > 0 ? $Q_sensivel_total / $Q_total : 1.0;

// Vazão de ar (Q_sens = ρ · cp · V · ΔT)
$vazao_m3_s = $Q_sensivel_total / (1.2 * 1005 * $delta_T_ar);
$vazao_m3_h = $vazao_m3_s * 3600;

// Capacidade
$Q_com_margem = $Q_total * (1 + $margem_seguranca);
$margem_w = $Q_com_margem - $Q_total;
$BTU_h = $Q_com_margem * 3.412;
$TR = $Q_com_margem / 3517;

// Equipamento sugerido
$equip_sugerido = end($EQUIPAMENTOS_COMERCIAIS);
foreach ($EQUIPAMENTOS_COMERCIAIS as $cap) {
    if ($cap >= $BTU_h) { $equip_sugerido = $cap; break; }
}
$equip_nome = "Split " . number_format($equip_sugerido, 0, ',', '.') . " BTU/h";

// Avaliação do SHR
if ($SHR >= 0.85) $shr_status = ['texto' => 'Seco / Padrão', 'cor' => '#10b981'];
elseif ($SHR >= 0.75) $shr_status = ['texto' => 'Ideal', 'cor' => '#10b981'];
elseif ($SHR >= 0.65) $shr_status = ['texto' => 'Úmido / Desumidificação', 'cor' => '#f59e0b'];
else $shr_status = ['texto' => 'Muito Úmido / Cuidado', 'cor' => '#ef4444'];

// ============================================================
// SALVAR POST
// ============================================================
if ($_SERVER["REQUEST_METHOD"] === "POST" && !empty($_POST['salvar_dimensionamento'])) {
    // Limpa resultado anterior
    $conn->query("DELETE FROM resultados_calculo WHERE ambiente_id = $ambiente_id AND projeto_id = $projeto_id");
    
    $stmt = $conn->prepare("INSERT INTO resultados_calculo 
        (projeto_id, ambiente_id, carga_conducao_w, carga_solar_w, carga_interna_w,
         carga_ventilacao_w, carga_bruta_w, margem_seguranca_w, carga_total_w,
         carga_sensivel_w, carga_latente_w, shr, vazao_ar_m3h,
         carga_total_btu, aparelho_recomendado, delta_t_c, volume_m3)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
    
    $q_conducao = $Q_paredes_cond + $Q_janelas_cond;
    $q_solar = $Q_paredes_rad + $Q_janelas_rad;
    $q_interna = $Q_int_sens + $Q_int_lat;
    $q_ventilacao = $Q_infiltracao_total;
    $q_bruta = $Q_total;
    $q_total_final = $Q_com_margem;
    $btu_final = $BTU_h;
    
    $stmt->bind_param("iidddddddddddddsd",
        $projeto_id, $ambiente_id,
        $q_conducao, $q_solar, $q_interna, $q_ventilacao,
        $q_bruta, $margem_w, $q_total_final,
        $Q_sensivel_total, $Q_latente_total, $SHR, $vazao_m3_h,
        $btu_final, $equip_nome, $delta_T, $volume_ambiente
    );
    
    if (!$stmt->execute()) {
        error_log("Erro INSERT resultados_calculo: " . $stmt->error);
    }
    
    if (empty($_POST['salvar_apenas'])) {
        header("Location: ambiente_resultado.php?projeto_id=$projeto_id&ambiente_id=$ambiente_id");
        exit;
    } else {
        $mensagem_sucesso = "Dimensionamento salvo com sucesso!";
    }
}
