<?php
/**
 * ETAPA A v2 — Cálculo Horário CORRIGIDO
 * - Usa ganho_solar (janelas reais) 
 * - Corrige condução (U×A×ΔT sem fator errado)
 * - Trata latitude NULL
 * - Fatores ASHRAE para carga interna
 */

function posicao_solar($latitude, $dia_ano, $hora_solar) {
    $declinacao = 23.45 * sin(deg2rad(360 * (284 + $dia_ano) / 365));
    $angulo_horario = 15 * ($hora_solar - 12);
    $sin_elev = sin(deg2rad($latitude)) * sin(deg2rad($declinacao))
              + cos(deg2rad($latitude)) * cos(deg2rad($declinacao))
              * cos(deg2rad($angulo_horario));
    $elevacao = rad2deg(asin(max(-1, min(1, $sin_elev))));
    if ($elevacao <= 0) return ['elevacao' => 0, 'azimute' => 0];
    $cos_azim = (sin(deg2rad($declinacao)) - sin(deg2rad($latitude)) * sin(deg2rad($elevacao)))
              / (cos(deg2rad($latitude)) * cos(deg2rad($elevacao)));
    $cos_azim = max(-1, min(1, $cos_azim));
    $azimute = rad2deg(acos($cos_azim));
    if ($angulo_horario > 0) $azimute = 360 - $azimute;
    return ['elevacao' => round($elevacao, 2), 'azimute' => round($azimute, 2)];
}

function irradiacao_vertical($irr_normal, $elevacao, $azimute_sol, $orientacao_parede) {
    $diferenca = abs($azimute_sol - $orientacao_parede);
    if ($diferenca > 180) $diferenca = 360 - $diferenca;
    $cos_inc = max(0, cos(deg2rad($elevacao)) * cos(deg2rad($diferenca)));
    $direta = $irr_normal * $cos_inc;
    $difusa = $irr_normal * 0.30 * (1 + cos(deg2rad(90))) / 2;
    return round($direta + $difusa, 2);
}

function irradiacao_normal_tipica($mes, $hora) {
    // Pico de 950 W/m² no verão (Brasil), às 13h
    $fator_mes = [0.85,0.90,0.95,1.00,1.05,1.10,1.10,1.05,1.00,0.95,0.90,0.85][$mes-1];
    $fator_hora = max(0, 1 - pow(($hora - 13) / 6, 2));
    return round(950 * $fator_mes * $fator_hora, 2);
}

function temp_externa_tipica($mes, $hora, $temp_pico) {
    // Variação de ±5°C ao longo do dia, pico às 15h
    $variacao = 5 * sin(deg2rad(($hora - 9) * 15));
    // Reduz no inverno (jun/ago)
    $fator_inverno = in_array($mes, [6,7,8]) ? 0.7 : 1.0;
    return round($temp_pico + $variacao * $fator_inverno - 2, 1);
}

function normaliza_orientacao($s) {
    $s = strtoupper(trim($s ?? 'N'));
    if (strpos($s, 'NOR') !== false) return 'N';
    if (strpos($s, 'SUL') !== false || strpos($s, 'SOU') !== false) return 'S';
    if (strpos($s, 'LES') !== false || strpos($s, 'EAS') !== false) return 'L';
    if (strpos($s, 'OES') !== false || strpos($s, 'WES') !== false) return 'O';
    if (strpos($s, 'NAS') !== false) return 'L';  // Nascente = Leste
    if (strpos($s, 'POE') !== false) return 'O';  // Poente = Oeste
    return substr($s, 0, 1);
}

function calcular_perfil_horario($conn, $ambiente_id) {
    // Ambiente + projeto
    $stmt = $conn->prepare("
        SELECT a.*, p.latitude, p.cidade, p.uf, p.temp_externa_verao
        FROM ambientes a
        JOIN projetos p ON p.id = a.projeto_id
        WHERE a.id = ?
    ");
    $stmt->bind_param('i', $ambiente_id);
    $stmt->execute();
    $amb = $stmt->get_result()->fetch_assoc();
    $stmt->close();
    
    if (!$amb) return ['erro' => 'Ambiente não encontrado'];
    
    $area_piso = floatval($amb['comprimento_m']) * floatval($amb['largura_m']);
    $altura    = floatval($amb['peDireita_m'] ?? 2.8);
    $latitude  = floatval($amb['latitude'] ?? -23.55);
    if ($latitude == 0) $latitude = -23.55;
    $temp_int  = floatval($amb['temp_interna'] ?? 24.0);
    $temp_pico = floatval($amb['temp_externa'] ?? $amb['temp_externa_verao'] ?? 32.0);
    
    // ===== GANHO SOLAR (janelas reais) =====
    $ganhos = [];
    $r = $conn->query("SELECT * FROM ganho_solar WHERE ambiente_id = $ambiente_id");
    if ($r) { while ($row = $r->fetch_assoc()) $ganhos[] = $row; }
    
    // ===== PAREDES (condução) =====
    $paredes = [];
    $r = $conn->query("SELECT * FROM paredes WHERE ambiente_id = $ambiente_id");
    if ($r) { while ($row = $r->fetch_assoc()) $paredes[] = $row; }
    
    // Se não tem paredes com área, calcula pela geometria do ambiente
    $tem_parede_valida = false;
    foreach ($paredes as $p) {
        if (floatval($p['area_m2'] ?? 0) > 0) { $tem_parede_valida = true; break; }
    }
    
    // Área de envoltória teórica (perímetro × altura)
    $perimetro = 2 * (floatval($amb['comprimento_m']) + floatval($amb['largura_m']));
    $area_env_teorica = $perimetro * $altura - floatval($amb['area_vidro_m2'] ?? 0);
    
    // Limpa cálculos anteriores
    $conn->query("DELETE FROM carga_horaria WHERE ambiente_id = $ambiente_id");
    
    $stmt_ins = $conn->prepare("
        INSERT INTO carga_horaria 
        (ambiente_id, mes, hora, elevacao_sol, azimute_sol,
         irr_norte, irr_sul, irr_leste, irr_oeste,
         carga_solar_w, carga_interna_w, carga_conducao_w, carga_total_w, temp_externa_c)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)
    ");
    
    $pico = ['carga' => 0, 'mes' => 0, 'hora' => 0];
    
    for ($mes = 1; $mes <= 12; $mes++) {
        $dia_ano = ($mes - 1) * 30 + 15;
        for ($hora = 6; $hora <= 18; $hora++) {
            $sol = posicao_solar($latitude, $dia_ano, $hora);
            $irr_norm = irradiacao_normal_tipica($mes, $hora);
            
            $irr = [
                'N' => irradiacao_vertical($irr_norm, $sol['elevacao'], $sol['azimute'], 0),
                'L' => irradiacao_vertical($irr_norm, $sol['elevacao'], $sol['azimute'], 90),
                'S' => irradiacao_vertical($irr_norm, $sol['elevacao'], $sol['azimute'], 180),
                'O' => irradiacao_vertical($irr_norm, $sol['elevacao'], $sol['azimute'], 270),
            ];
            
            // ===== CARGA SOLAR (via ganho_solar) =====
            $carga_solar = 0;
            foreach ($ganhos as $g) {
                $orient = normaliza_orientacao($g['orientacao'] ?? 'N');
                $area_v = floatval($g['area_vidro_m2'] ?? 0);
                $trans  = floatval($g['transmissividade'] ?? 0.85);
                $fs     = floatval($g['fator_sombra'] ?? 1.0);
                // SHGC efetivo = transmissividade × fator_sombra
                $shgc = $trans * $fs;
                $carga_solar += ($irr[$orient] ?? 0) * $area_v * $shgc;
            }
            
            // ===== CARGA INTERNA (ASHRAE) =====
            $pessoas = intval($amb['pessoas'] ?? 1);
            // 130 W/pessoa (sensível ~75 + latente ~55, escritório)
            $carga_pessoas = $pessoas * 130;
            
            // Iluminação: 100% das 8-18h, 20% fora
            $pot_ilum = floatval($amb['potencia_iluminacao_w'] ?? 100);
            $fator_ilum = ($hora >= 8 && $hora <= 18) ? 1.0 : 0.2;
            $carga_ilum = $pot_ilum * $fator_ilum;
            
            // Equipamentos: 100% das 8-22h, 30% fora
            $pot_equip = floatval($amb['potencia_equipamentos_w'] ?? 150);
            $fator_equip = ($hora >= 8 && $hora <= 22) ? 1.0 : 0.3;
            $carga_equip = $pot_equip * $fator_equip;
            
            $carga_interna = $carga_pessoas + $carga_ilum + $carga_equip;
            
            // ===== CONDUÇÃO (U×A×ΔT) =====
            $temp_ext_h = temp_externa_tipica($mes, $hora, $temp_pico);
            $delta_t = $temp_ext_h - $temp_int;
            
            $carga_conducao = 0;
            if ($tem_parede_valida) {
                // Usa paredes reais
                foreach ($paredes as $p) {
                    if (intval($p['do_lado_exterior']) != 1) continue;
                    $area_p = floatval($p['area_m2'] ?? 0);
                    $u_p = floatval($p['coeficiente_transmissao_k'] ?? 1.75);
                    $carga_conducao += max(0, $delta_t) * $area_p * $u_p;
                }
            } else {
                // Calcula por geometria (U médio = 2.0 W/m²K)
                $u_medio = 2.0;
                $carga_conducao = max(0, $delta_t) * $area_env_teorica * $u_medio;
            }
            
            $carga_total = $carga_solar + $carga_interna + $carga_conducao;
            
            if ($carga_total > $pico['carga']) {
                $pico = ['carga' => $carga_total, 'mes' => $mes, 'hora' => $hora];
            }
            
            $stmt_ins->bind_param('iiiidddddddddd',
                $ambiente_id, $mes, $hora,
                $sol['elevacao'], $sol['azimute'],
                $irr['N'], $irr['S'], $irr['L'], $irr['O'],
                $carga_solar, $carga_interna, $carga_conducao, $carga_total, $temp_ext_h
            );
            $stmt_ins->execute();
        }
    }
    $stmt_ins->close();
    
    return [
        'sucesso' => true, 
        'pico' => $pico, 
        'area' => $area_piso,
        'janelas' => count($ganhos),
        'paredes' => count($paredes)
    ];
}
